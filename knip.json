{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["src/**/*.ts"]
    },
    "example": {
      "project": ["src/**/*.ts"]
    },
    "demo": {
      "entry": ["src/styles.css"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "docs": {
      "project": ["**/*.{ts,tsx,mjs,astro,mdx}"]
    }
  },
  "tags": ["-lintignore"]
}
