{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc", "vitest", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "coverage/**", "docs/.astro/**"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/no-duplicates": "error",
    "import/no-cycle": "off",
    "typescript/consistent-type-imports": [
      "warn",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expect[A-Z]*"]
      }
    ],
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "checkTypeImports": true,
        "pattern": {
          "js": "never",
          "ts": "always"
        }
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["node:*"],
            "message": "The library runs in browsers too: use web APIs instead of Node built-ins."
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "Buffer",
        "message": "The library runs in browsers too: use Uint8Array and the helpers in src/encoding.ts."
      },
      {
        "name": "process",
        "message": "The library runs in browsers too: take settings as options instead."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "vitest.config.ts",
        "example/**",
        "demo/vite.config.ts",
        "docs/astro.config.mjs",
        "docs/src/api.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    }
  ]
}
